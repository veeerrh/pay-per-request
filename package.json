{
  "name": "di06-pay-per-call",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup-hooks": "git config core.hooksPath .githooks",
    "build": "tsc -p packages/guard",
    "typecheck": "tsc --noEmit -p packages/guard",
    "test": "npm run build && vitest run",
    "test:guard": "vitest run packages/guard",
    "dry-run": "node scripts/dry-run.js",
    "invariant": "node scripts/invariant.js",
    "start": "node scripts/start-all.js",
    "start:sellers": "node scripts/start-all.js --sellers",
    "task": "node packages/buyer/src/cli.js",
    "scan": "node scripts/write-hygiene.js",
    "scan:bundle": "node scripts/bundle-scan.js",
    "start:public": "node scripts/start-all.js --public",
    "tunnel": "node scripts/tunnel.js",
    "health": "node scripts/health.js"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "viem": "^2.57.7"
  }
}
