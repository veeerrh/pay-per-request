# --- Network (testnet only; the startup guard refuses anything else) ---
NETWORK=eip155:84532
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
FACILITATOR_URL=https://x402.org/facilitator
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# --- Keys: generated by scripts/gen-wallets.js. NEVER commit .env ---
BEACON_PRIVATE_KEY=
SPARE_BUYER_PRIVATE_KEY=
REPLAY_PRIVATE_KEY=

# --- Operator ---
OPERATOR_TOKEN=
ENABLE_ATTACK_PANEL=true

# --- Modes ---
NODE_ENV=development
DEMO_MODE=false
ALLOW_PRIVATE_ENDPOINTS=false

PUBLIC_BASE_URL=
MAX_TASK_BUDGET=5000000
LEDGER_WRITERS=
# --- Model (Gemini). Leave the key empty to run every agent rule-based. Only packages/llm reads it. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
BEACON_LLM=on
# Each agent uses only its own key, so one agent cannot spend another's quota. Seller agents never receive GEMINI_API_KEY.
ATLAS_GEMINI_API_KEY=
TREMOR_GEMINI_API_KEY=
BRIEF_GEMINI_API_KEY=
