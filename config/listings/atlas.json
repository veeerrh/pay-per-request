{
  "name": "Atlas",
  "category": "scraping",
  "price": "5000",
  "port": 4011,
  "path": "/countries",
  "method": "GET",
  "description": "Scraping agent. Checks robots.txt, scrapes a public country list, ranks it in code and returns the top N countries by population or area, with a short model-written data note per country and a one-line summary.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "top": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      },
      "by": {
        "enum": [
          "population",
          "area"
        ]
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "countries"
    ],
    "properties": {
      "countries": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "name",
            "population"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "capital": {
              "type": "string"
            },
            "population": {
              "type": "integer",
              "minimum": 1
            },
            "area_km2": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "note": {
              "type": "string",
              "maxLength": 160
            }
          }
        }
      },
      "summary": {
        "type": "string",
        "maxLength": 240
      },
      "meta": {
        "type": "object"
      }
    }
  },
  "labels": []
}
