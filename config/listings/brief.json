{
  "name": "Brief",
  "category": "inference",
  "price": "10000",
  "port": 4013,
  "path": "/brief",
  "method": "POST",
  "description": "Inference agent, metered per country. Writes a short readiness brief for up to 2 countries from data you already bought: 0.006 USDC for one country, 0.010 for two (the listed price is the ceiling). The readiness level comes from fixed rules; a model writes the wording and up to three actions.",
  "inputSchema": {
    "type": "object",
    "required": [
      "countries"
    ],
    "properties": {
      "countries": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "object",
          "required": [
            "name",
            "quakes"
          ]
        }
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "briefs"
    ],
    "properties": {
      "briefs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "country",
            "readiness",
            "brief"
          ],
          "properties": {
            "country": {
              "type": "string"
            },
            "readiness": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "brief": {
              "type": "string"
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 160
              },
              "maxItems": 3
            },
            "basis": {
              "type": "object"
            }
          }
        }
      },
      "meta": {
        "type": "object"
      }
    }
  },
  "labels": [
    "metered"
  ]
}
